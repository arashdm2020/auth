# Serverless Postgres connection injected by the Neon Vercel integration.
# The app also accepts POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, or POSTGRES_URL.
# Never commit an actual connection string.
DATABASE_URL=

# Public TRON address allowed to complete ownership verification.
# Never place a private key or recovery phrase in this file.
AUTHORIZED_WALLET_ADDRESS=TEq6bXGJ5rkpUjgb3ygVyMJ6FXxWqLA3Cy
AUTHORIZED_AMOUNT=35000
AUTHORIZED_ASSET=USDT
AUTHORIZED_REFERENCE=AUTH-35000-TRC20

# To authorize multiple wallets, use this JSON array instead of the four values above.
# AUTHORIZED_WALLETS_JSON=[{"address":"T...","amount":"35000","asset":"USDT","reference":"AUTH-001"}]

# Public receiving wallet. Its latest TRX balance is read server-side from TRON FullNode HTTP API.
BASE_WALLET_ADDRESS=TRou4EavgzEMoBp3V93LNaaiKY3Y3Rg5Cx

# Recommended for production TronGrid rate limits. Keep the actual key secret.
TRONGRID_API_KEY=

# Required to read the lightweight operations API. Use a long random value.
ADMIN_ACCESS_TOKEN=

# Trusted absolute public origin used for social metadata after deployment.
SITE_ORIGIN=http://localhost:3000
